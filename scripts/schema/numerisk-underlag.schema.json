{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobbcoach.ai/schema/numerisk-underlag.schema.json",
  "title": "Numeriskt underlag, avancerad",
  "description": "Samma form som Passage i numericalTestV2/types.ts plus frivilliga fält som gör facit maskinellt kontrollerbart. Dokumentation: valideringen görs i scripts/validate-numerisk-bank.mjs.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "type", "topic", "difficulty", "contextText", "questions"],
    "properties": {
      "id": { "type": "string", "pattern": "^na-\d{2}-[a-z0-9-]+$" },
      "title": { "type": "string" },
      "type": { "enum": ["table", "graph"] },
      "topic": { "type": "string" },
      "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
      "contextText": { "type": "string" },
      "dataTable": {
        "type": "object",
        "required": ["headers", "rows"],
        "properties": {
          "headers": { "type": "array", "items": { "type": "string" } },
          "rows": { "type": "array", "items": { "type": "array", "items": { "type": ["string", "number"] } } },
          "caption": { "type": "string" }
        }
      },
      "chartData": {
        "type": "object",
        "required": ["chartType", "data"],
        "properties": {
          "chartType": { "enum": ["bar", "line", "pie"] },
          "title": { "type": "string" },
          "data": { "type": "array" },
          "unit": { "type": "string" },
          "xAxisLabel": { "type": "string" },
          "yAxisLabel": { "type": "string" }
        }
      },
      "ovanvant": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(rad|kolumn|stapel|punkt) .+$" } },
      "enhetsbyte": { "type": "string", "pattern": "^.+ till .+$" },
      "questions": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "object",
          "required": ["id", "passageId", "questionNumber", "questionText", "options", "correctAnswerId", "explanation", "difficulty"],
          "properties": {
            "id": { "type": "string", "pattern": "^na-\d{2}-q0[1-4]$" },
            "options": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": ["id", "text", "isCorrect"],
                "properties": {
                  "id": { "type": "string" },
                  "text": { "type": "string" },
                  "isCorrect": { "type": "boolean" },
                  "misstag": {
                    "type": "object",
                    "required": ["typ", "uttryck", "varde"],
                    "properties": {
                      "typ": { "enum": ["fel_rad", "fel_kolumn", "steg_saknas", "fel_enhet", "fel_operation", "avrundning", "fel_bas"] },
                      "uttryck": { "type": "string" },
                      "varde": { "type": "number" }
                    }
                  }
                }
              }
            },
            "berakning": {
              "type": "object",
              "required": ["steg", "precision"],
              "properties": {
                "steg": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["uttryck", "varde"], "properties": { "text": { "type": "string" }, "uttryck": { "type": "string" }, "varde": { "type": "number" } } } },
                "visning": { "type": "string" },
                "precision": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
