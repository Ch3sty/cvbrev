<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Ingen säkerhetskopiering: webbvyns kakor bär inloggningen, och en
        återställd session på en ny telefon ska inte följa med. Kontot och
        resultaten ligger på servern ändå.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                App Links (plan 2.5): mejllänkar som skickas från appen öppnar appen.
                Bara den egna prefixen /auth/app/, så att webbens bekräftelse- och
                återställningslänkar (/auth/confirm, /api/auth/confirm-email,
                /auth/callback) fortsätter att öppnas i webbläsaren även när appen
                är installerad. Verifieras mot public/.well-known/assetlinks.json
                (mall i mobilapp/butik/assetlinks.json).
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.jobbcoach.ai" />
                <data android:pathPrefix="/auth/app/" />
            </intent-filter>

        </activity>

        <!-- Notiser (FCM): luckan som vit siluett, kopparn som accent. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_testklar" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/koppar" />


        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
